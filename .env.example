# ============================================================================
# home2hatyai — ตัวอย่างการตั้งค่า
# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง (ห้าม commit .env.local ขึ้น git)
# ============================================================================

# ---- Supabase (จำเป็น) --------------------------------------------------
# หาได้ที่ Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⚠️ คีย์นี้ข้าม RLS ได้ทั้งหมด ใช้เฉพาะฝั่งเซิร์ฟเวอร์
#    ห้ามขึ้นต้นด้วย NEXT_PUBLIC_ และห้ามใส่ในโค้ดฝั่งเบราว์เซอร์เด็ดขาด
SUPABASE_SERVICE_ROLE_KEY=

# ---- Google Maps (จำเป็นถ้าต้องการแผนที่) --------------------------------
# เปิดใช้ Maps JavaScript API แล้วจำกัดคีย์ตามโดเมนเว็บ (HTTP referrer)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# เปิดใช้ Geocoding API แยกอีกคีย์ และจำกัดตาม IP ของเซิร์ฟเวอร์
# ถ้าไม่ใส่ ระบบจะใช้พิกัดกึ่งกลางตำบล/อำเภอโดยประมาณแทน (ยังใช้งานได้)
GOOGLE_GEOCODING_API_KEY=

# ---- ระบบเก็บข้อมูล ------------------------------------------------------
# กุญแจลับสำหรับลงลายเซ็นคำขอเข้า /api/ingest
# สร้างด้วย: openssl rand -hex 32
INGEST_SECRET=

# URL ของแอปนี้ ใช้ตอนรันสคริปต์เก็บข้อมูล
APP_URL=http://localhost:3000

# ---- Facebook Graph API (ไม่บังคับ) --------------------------------------
# ใช้ได้เฉพาะกลุ่ม/เพจที่คุณเป็นแอดมินเอง — อ่าน docs/DATA-COLLECTION.md ก่อนใช้
FB_ACCESS_TOKEN=
FB_GROUP_IDS=
FB_PAGE_IDS=
SINCE_DAYS=7

# ---- LINE bot เดิม (ไม่บังคับ) -------------------------------------------
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
SHEET_CSV_URL=
